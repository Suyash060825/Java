class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {

        int count = 0;

        for(int i = 0; i < flowerbed.length; i++)
        {
            if(flowerbed[i] == 0)
            {
                int j = i - 1;
                int k = i + 1;

                boolean left = (j < 0) || flowerbed[j] == 0;
                boolean right = (k >= flowerbed.length) || flowerbed[k] == 0;

                if(left && right)
                {
                    flowerbed[i] = 1;
                    count++;
                }
            }
        }

        return count >= n;
    }
}
